{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZDSM Validation Record",
  "type": "object",
  "required": [
    "validation_id",
    "rule_id",
    "result"
  ],
  "properties": {
    "validation_id": {
      "type": "string"
    },
    "rule_id": {
      "type": "string"
    },
    "chart_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "analysis_window": {
      "type": [
        "string",
        "null"
      ]
    },
    "prediction_or_claim": {
      "type": "string"
    },
    "observable_indicators": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "result": {
      "enum": [
        "observed",
        "partially_observed",
        "not_observed",
        "unknown"
      ]
    },
    "notes": {
      "type": "string"
    },
    "recorded_at": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}